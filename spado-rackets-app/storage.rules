rules_version = '2';

// Reglas de Firebase Storage — Spado Rackets.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function rol() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data.get('role', '');
    }

    function esFamiliaVinculada() {
      let u = firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
      return u.get('role', '') == 'familia' && u.get('grupos', []).size() > 0;
    }

    // Justificantes de pago. La carpeta lleva el uid de quien sube y la regla
    // lo comprueba: cada familia sólo escribe en la suya, así que nadie puede
    // sustituir el justificante de otra. Se crean y no se sobrescriben.
    //
    // Los lee la familia que lo subió y Dirección. Nadie más: un justificante
    // lleva datos bancarios de la familia.
    match /comprobantes/{uid}/{archivo} {
      allow read: if isSignedIn()
        && (request.auth.uid == uid || rol() == 'direccion');

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && esFamiliaVinculada()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType in
             ['image/jpeg', 'image/png', 'image/webp', 'image/heic',
              'image/heif', 'application/pdf'];

      allow update, delete: if false;
    }

    function alumnaDoc(id) {
      return firestore.get(/databases/(default)/documents/alumnas/$(id)).data;
    }

    function usuarioDoc() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    // Fotos de las alumnas. Las sube Dirección; las ven Dirección, la familia
    // de esa alumna y el staff del grupo. Nadie más: son fotos de menores.
    match /fotos/{alumnaId}/{archivo} {
      allow read: if isSignedIn() && (
        rol() == 'direccion'
        || (rol() == 'familia'
            && alumnaDoc(alumnaId).get('familiaUid', '') == request.auth.uid)
        || (rol() == 'staff'
            && alumnaDoc(alumnaId).get('grupo', '') in usuarioDoc().get('grupos', []))
      );

      allow create: if isSignedIn()
        && rol() == 'direccion'
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';

      allow update: if false;
      allow delete: if isSignedIn() && rol() == 'direccion';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
